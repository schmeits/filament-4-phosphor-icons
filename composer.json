{
    "name": "schmeits/filament-4-phosphor-icons",
    "description": "Phosphor icons for Filament 4 and 5 as a backed enum that scales with Filament's icon sizes, in all six Phosphor weights.",
    "keywords": [
        "schmeits",
        "laravel",
        "filament",
        "filament-plugin",
        "icons",
        "phosphor",
        "phosphor-icons",
        "blade-icons"
    ],
    "homepage": "https://github.com/schmeits/filament-4-phosphor-icons",
    "support": {
        "issues": "https://github.com/schmeits/filament-4-phosphor-icons/issues",
        "source": "https://github.com/schmeits/filament-4-phosphor-icons"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Tally Schmeits",
            "email": "tally@schmeits.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "codeat3/blade-phosphor-icons": "^2.4",
        "filament/filament": "^4.13.2|^5.8.2",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Schmeits\\FilamentPhosphorIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schmeits\\FilamentPhosphorIcons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "generate-enum": "@php bin/generate-enum.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schmeits\\FilamentPhosphorIcons\\FilamentPhosphorIconsServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
